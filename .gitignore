# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# VoxPolish runtime artifacts (never commit audio/sessions)
voxpolish_workspace/
*_session/
voxpolish_out/
*.wav
*.flac
*.mp3
*.m4a
!voxpolish/tests/**/*.wav
# TimberTones ships its CC0 piano samples as app assets (not vocal recordings).
!timbertones/samples/*.mp3

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Vox analysis component keeps its own ignore rules (runtime uploads, engine
# output, coaching data) in voxanalysis/.gitignore — preserved from the
# original vox-cloud-alpha repository.

# Host-side working directories that appear untracked in Candi's checkout.
# Listed so a `git add -A` during a migration cannot commit a virtualenv or
# gigabytes of separated audio into the repo.
.venv-suite/
.vox-suite-runtime/
voxanalysis/vox-analysis/output/
voxanalysis/vox-analysis/reports/
voxanalysis/youtube-downloader/.venv-reference/
*.pre-reanalysis

# Session-level analysis artefacts (rule 9: no audio/stems/plots in repo)
output/
reports/
Onset-Map-*.png

# Generated standalone hub builds (regenerated per host via tools/build_hub.py)
voxsuite/dist/
